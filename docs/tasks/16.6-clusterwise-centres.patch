+/**
+ * The best of a list of tools, under every setup, or nothing worth doing.
+ *
+ * The one place a round is decided, so that the passes below differ in which
+ * tools they hand it and in nothing else. A setup is free to try because it is
+ * a face turn: a face turn cannot take a centre off its face, so it never
+ * changes how many are home -- only which of a face's pieces sits where a tool
+ * will reach -- and it is left on rather than taken back because doing so
+ * costs a move and nothing else.
+ */
+[[nodiscard]] Choice best_centre_tool(const Work& work, const Board& board,
+                                      const std::vector<Prepared>& tools,
+                                      const std::vector<std::vector<int>>& sources,
+                                      const std::vector<std::size_t>& among,
+                                      const Carries& wanted)
+{
+    Choice choice;
+    int best = 0;
+
+    for (const std::size_t i : among) {
+        if (!worth_trying(tools[i].carries, wanted)) continue;
+        for (std::size_t s = 0; s < sources.size(); ++s) {
+            const int delta =
+                board.gain(work.cube(), sources[s], tools[i].moved);
+            if (delta <= best) continue;
+            best = delta;
+            choice = Choice{i, s, true};
+        }
+    }
+    return choice;
+}
